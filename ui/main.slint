
import { LineEdit, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "ClipFlow";
    width: 380px;
    height: 560px;
    background: #f3f3f3;

    in property <[string]> clipboard_items: [];

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header: อยู่ด้านบนเสมอ
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Clipboard";
                font-size: 24px;
                font-weight: 700;
                color: #202020;
            }

            Text {
                text: "Clear all";
                color: #2563eb;
                vertical-alignment: center;
            }
        }

        // Search: อยู่ด้านบนเสมอ
        LineEdit {
            placeholder-text: "Search clipboard...";
        }

        // Section title
        Text {
            text: "Recent";
            font-size: 16px;
            font-weight: 600;
            color: #202020;
        }

        if root.clipboard_items.length > 0: ScrollView {
            VerticalLayout {
                spacing: 8px;

                for item in root.clipboard_items: Rectangle {
                    background: #ffffff;
                    border-radius: 8px;
                    height: 75px;

                    VerticalLayout {
                        padding: 12px;
                        alignment: center;

                        Text {
                            text: item;
                            color: #202020;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.clipboard_items.length == 0: VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: "📋";
                font-size: 36px;
                horizontal-alignment: center;
            }

            Text {
                text: "No clipboard history";
                color: #444444;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: "Copy something and it will appear here.";
                color: #888888;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }
}
